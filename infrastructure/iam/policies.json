{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3StudentDocumentsAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::student-management-docs-akash-2026",
        "arn:aws:s3:::student-management-docs-akash-2026/*"
      ]
    },
    {
      "Sid": "CloudWatchMonitoringLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaExecutionAccess",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:GetFunction"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:*:function:student-management-api"
    }
  ]
}
